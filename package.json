{
  "name": "pc-bridge",
  "version": "1.1.0",
  "description": "Link two Windows PCs over Tailscale + SSH: live stats, move Docker containers and Node/Python programs between them, fast LAN copies, local API. No Electron.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/src/server.js",
    "test": "tsc && node dist/test/e2e.js",
    "dist": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Ratnesh Dagli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratneshdagli/PcBridge.git"
  },
  "homepage": "https://github.com/ratneshdagli/PcBridge#readme",
  "bugs": {
    "url": "https://github.com/ratneshdagli/PcBridge/issues"
  },
  "keywords": [
    "tailscale",
    "ssh",
    "docker",
    "windows",
    "offload",
    "homelab",
    "self-hosted",
    "nodejs"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "private": true
}
